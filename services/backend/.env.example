# ── Application ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./dev.db
# For PostgreSQL + PostGIS (production):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/vehicle_intelligence
APP_NAME="Vehicle Intelligence Backend"
DEBUG=true

# ── ANPR ─────────────────────────────────────────────────────────
# Path to the best.pt file from the services/alpr repo
ANPR_WEIGHTS_PATH=../alpr/best.pt
ANPR_DEVICE=
ANPR_REGION=IN
ANPR_CONFIDENCE=0.25

# ── Redis & Caching ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# ── Kafka Message Broker ─────────────────────────────────────────
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_EVENTS=raw_vehicle_events
KAFKA_TOPIC_SNAPSHOTS=traffic_snapshots
USE_KAFKA=false
