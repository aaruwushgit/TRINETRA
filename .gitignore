*.DS_Store

# local editor / assistant state
.obsidian/
.claude/settings.local.json

# large local artifacts (not tracked, kept on disk)
archive/
vehicle_models.zip
vehicle_models/

# secrets — real env files never get committed, only the .example templates.
# This repo is public and NEXT_PUBLIC_TOMTOM_API_KEY / API keys live in these.
.env
.env.*
!.env.example
!.env.*.example

# node / next
node_modules/
.next/
next-env.d.ts

# python
.venv/
venv/
__pycache__/
*.pyc

# service-local data (services are their own submodules with their own .gitignore too)
services/**/dev.db*
services/**/sandbox_dbs/
services/**/uploads/
services/**/job_outputs/
